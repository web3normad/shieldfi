# ShieldFi Environment Configuration
# Copy this file to .env and fill in your values

# Deployment Configuration
PRIVATE_KEY=your_private_key_here
RPC_URL=https://ethereum-holesky-rpc.publicnode.com
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Network (holesky, mainnet, sepolia)
NETWORK=holesky

# Contract Configuration
OWNER_ADDRESS=0x7e6d2471Cda8cc8bdB41B429D6c774e9cf0B7B52

# MEV Protection Settings
MEV_THRESHOLD=1000000000000000000000  # 1000 tokens
REDISTRIBUTION_RATE=1000              # 10% (basis points)
PROTECTION_FEE=100                    # 1% (basis points)
LIQUIDATION_THRESHOLD=100000000000000000000  # 100 tokens

# EigenLayer AVS Settings
MIN_VALIDATOR_STAKE=32000000000000000000  # 32 ETH
MAX_VALIDATORS=100
VALIDATION_TIMEOUT=30                     # 30 seconds

# Uniswap V4 Settings
POOL_MANAGER_ADDRESS=0x...  # Will be set during deployment
HOOK_FLAGS=0x3000           # BEFORE_SWAP | AFTER_SWAP 